# --- required ---
DISCORD_TOKEN=
# Your Discord user ID(s), comma separated. Only these users can use the bot.
ALLOWED_USER_IDS=

# --- recommended ---
# Your Discord server (guild) ID: makes slash commands appear instantly.
GUILD_ID=
# Jellyfin: lets the bot trigger a library scan when downloads finish.
# Use the address you'd open from the laptop itself. Create the key in
# Jellyfin > Dashboard > API Keys.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# --- optional ---
# Post a MAL/AniList link in this channel and the bot reacts without a command.
# Needs "Message Content Intent" enabled in the Discord developer portal.
WATCH_CHANNEL_ID=

# --- paths (defaults shown) ---
ANIME_DL=/home/shiki/anime-dl
ANIME_DIR=/srv/media/anime
MOVIES_DIR=/srv/media/movies
# Scratch space. Must be on the same filesystem as the two libraries above.
WORK_DIR=/srv/media/.anime-bot

DEFAULT_QUALITY=best
DEFAULT_DUB=0
# 1 = only accept a source search result whose title matches the search text exactly (ani-cli's
# ANI_CLI_EXACT). Stricter, so fewer wrong-show downloads but more "no results". Per-download: exact:True
DEFAULT_EXACT=0
# 0 = skip the "did the source return the right show?" check (not recommended)
VERIFY_TITLES=1
# Refuse to start a download when less than this much is free on the anime library's disk.
MIN_FREE_GB=5
# The queue, job history and episode counts are kept in WORK_DIR/state.json
# (so queued jobs resume after a restart).
